{
  "expo": {
    "name": "DhanMatrix",
    "slug": "dhanmatrix-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dhanmatrix",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#001F3F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhanmatrix.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to scan QR codes",
        "NSPhotoLibraryUsageDescription": "Select photos for profile"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#001F3F"
      },
      "package": "com.dhanmatrix.app",
      "permissions": ["NOTIFICATIONS", "RECEIVE_BOOT_COMPLETED", "VIBRATE"],
      "jsEngine": "hermes",
      "enableProguardInRelease": true,
      "softwareKeyboardLayoutMode": "pan",
      "navigationBar": {
        "visible": "leanback",
        "barStyle": "dark-content"
      },
      "windowSoftInputMode": "adjustResize",
      "edgeToEdgeLayoutEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#001F3F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "36419ed4-89c6-432f-ad9c-ed34c2ca19f5"
      }
    }
  }
}
